# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb

# Transcription
ELEVENLABS_API_KEY=sk_...

# LLM — AgentRouter (OpenAI-compatible gateway)
# Token: https://agentrouter.org/console/token
# Docs: https://docs.agentrouter.org/
AGENTROUTER_API_KEY=sk_...
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Models available on this token (do not use gpt-6-astra or claude-opus-5)
AGENTROUTER_SUMMARY_MODEL=claude-opus-4-8
AGENTROUTER_PREP_MODEL=deepseek-v4-flash

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Background jobs
# inline = run in the API process (development/tests)
# arq    = durable Redis-backed worker (production)
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379

# Storage
# local = data/ on disk (development/tests)
# s3    = any S3-compatible bucket (Neon Object Storage, R2, AWS S3)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=500

# App
APP_ENV=development
SECRET_KEY=change-me
DATA_DIR=data
PUBLIC_BASE_URL=http://127.0.0.1:8000
UI_BASE_URL=http://127.0.0.1:8501

# Auth
# dev  = seeded local user, no login (local development only)
# neon = Neon Auth / Managed Better Auth (production)
AUTH_MODE=dev
# Base URL ends with /auth. Add the UI_BASE_URL origin to Neon Auth trusted domains.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional. Leave empty to derive both from the auth host origin.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Require Neon Auth's email OTP before creating a LoWi session. Required in production.
REQUIRE_EMAIL_VERIFICATION=false
SESSION_TTL_DAYS=30

# Live capture
ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
LIVE_MAX_MINUTES=240
LIVE_TICKET_TTL_SECONDS=900

# Google Calendar (read-only). Redirect must match the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/calendar/callback
# Optional. On Render, paste the refresh_token from data/google_token.json so a restart keeps the connection.
GOOGLE_REFRESH_TOKEN=
